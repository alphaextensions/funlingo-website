# ----------------------------------------------------------------------
# Fun Learning — environment variables
# Copy this file to `.env.local` and fill in the real values.
# ----------------------------------------------------------------------

# Prisma / SQLite — the file lives at ./prisma/dev.db
DATABASE_URL="file:./dev.db"

# Auth.js v5
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Groq (OpenAI-compatible) — https://console.groq.com
GROQ_API_KEY=""
